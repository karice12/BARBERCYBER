generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PlanType {
  ESSENTIAL
  ENTERPRISE
}

enum AppointmentStatus {
  PENDING
  COMPLETED
  CANCELED
  NO_SHOW
}

// Espelha a tabela public.profiles do Supabase.
// O campo "id" é o mesmo UUID do auth.users (Supabase Auth).
model Profile {
  id            String        @id @db.Uuid
  name          String        @default("")
  planType      PlanType      @default(ESSENTIAL) @map("plan_type")
  hasPlus5Addon Boolean       @default(false)    @map("has_plus5_addon")
  createdAt     DateTime      @default(now())    @map("created_at")

  staff         Staff[]
  appointments  Appointment[]
  transactions  Transaction[]
  reportLogs    ReportLog[]

  @@map("profiles")
}

model ReportLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid  @map("user_id")
  endpoint  String
  createdAt DateTime @default(now()) @map("created_at")

  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("report_logs")
}

model Staff {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  specialty      String
  commissionRate Float         @default(0.40) @map("commission_rate")
  isAvailable    Boolean       @map("is_available")
  userId         String        @db.Uuid @map("user_id")
  createdAt      DateTime      @default(now()) @map("created_at")

  profile        Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments   Appointment[]

  @@index([userId])
  @@map("staff")
}

model Appointment {
  id           String            @id @default(uuid()) @db.Uuid
  clientName   String            @map("client_name")
  clientPhone  String            @map("client_phone")
  serviceName  String            @map("service_name")
  price        Float
  scheduledAt  DateTime          @map("scheduled_at")
  status       AppointmentStatus @default(PENDING)
  staffId      String            @db.Uuid @map("staff_id")
  userId       String            @db.Uuid @map("user_id")
  createdAt    DateTime          @default(now()) @map("created_at")

  staff        Staff             @relation(fields: [staffId], references: [id], onDelete: Restrict)
  profile      Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction  Transaction?

  @@index([staffId])
  @@index([userId])
  @@index([scheduledAt])
  @@map("appointments")
}

model Transaction {
  id              String      @id @default(uuid()) @db.Uuid
  grossValue      Float       @map("gross_value")
  commissionValue Float       @map("commission_value")
  netProfit       Float       @map("net_profit")
  date            DateTime
  appointmentId   String      @unique @db.Uuid @map("appointment_id")
  userId          String      @db.Uuid @map("user_id")
  createdAt       DateTime    @default(now()) @map("created_at")

  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  profile         Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@map("transactions")
}
