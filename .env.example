# =============================================================================
# BARBERCYBER PRO — Variáveis de Ambiente
# Copie este arquivo para ".env" no backend (pasta /server) e para
# ".env.local" no frontend (pasta raiz) e preencha os valores abaixo.
# NUNCA commite arquivos .env com valores reais no Git.
# =============================================================================

# =============================================================================
# BACKEND — /server/.env
# =============================================================================

# --- Supabase: Connection Strings para o Prisma ---
# Onde encontrar: Supabase Dashboard → Settings (engrenagem) → Database → Connection string
# Escolha a aba "URI". Cole a string completa abaixo.
# DATABASE_URL  = usa o PgBouncer (pooled) — use para queries normais do Prisma.
# DIRECT_URL    = conexão direta — necessária para migrations (prisma migrate).
DATABASE_URL="postgresql://postgres.[REF]:[SENHA]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[REF]:[SENHA]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Supabase: JWT Secret (para validar tokens do Supabase Auth no Express) ---
# Onde encontrar: Supabase Dashboard → Settings → API → JWT Settings → "JWT Secret"
# Clique em "Reveal" para ver o valor completo.
SUPABASE_JWT_SECRET="super-secret-jwt-token-gerado-pelo-supabase"

# --- Supabase: URL e Chaves de API ---
# Onde encontrar: Supabase Dashboard → Settings → API → "Project URL" e "Project API keys"
SUPABASE_URL="https://[REF].supabase.co"
SUPABASE_ANON_KEY="eyJ..."        # "anon public" — seguro para o cliente
SUPABASE_SERVICE_ROLE_KEY="eyJ..." # "service_role" — NUNCA exponha no frontend

# --- Stripe (pagamentos) ---
# Onde encontrar: dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Servidor Express ---
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# =============================================================================
# FRONTEND — .env.local (raiz do projeto)
# =============================================================================

# Onde encontrar: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL="https://[REF].supabase.co"
VITE_SUPABASE_ANON_KEY="eyJ..." # a mesma "anon public" key acima

# URL do seu backend Express (local ou produção)
VITE_API_URL="http://localhost:3000"
