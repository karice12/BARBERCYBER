# ─── Banco de Dados ────────────────────────────────────────────────────────────
# String de conexão PostgreSQL (ex: Supabase, Neon, Railway, etc.)
DATABASE_URL="postgresql://usuario:senha@host:5432/barbercyber?schema=public"

# Alternativa: se usar Supabase com Prisma Accelerate/Pooler
# SUPABASE_DATABASE_URL="postgresql://..."

# ─── Autenticação JWT ──────────────────────────────────────────────────────────
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# IDs dos preços dos planos no Stripe
STRIPE_ESSENTIAL_PRICE_ID="price_..."
STRIPE_ENTERPRISE_PRICE_ID="price_..."

# ─── URLs da Aplicação ─────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:5000"
PORT=3000
NODE_ENV="development"
